  "ricci": "\\left[\\begin{matrix}- \\frac{3}{\\ell^{2}} & 0 & 0 & 0\\\\0 & 3 \\cosh^{2}{\\left(\\frac{t}{\\ell} \\right)} & 0 & 0\\\\0 & 0 & \\left(\\frac{\\sinh{\\left(\\frac{2 t}{\\ell} \\right)} \\tanh{\\left(\\frac{t}{\\ell} \\right)}}{2} + \\cosh{\\left(\\frac{2 t}{\\ell} \\right)} + 2\\right) \\sin^{2}{\\left(\\chi \\right)} & 0\\\\0 & 0 & 0 & \\left(\\frac{\\sinh{\\left(\\frac{2 t}{\\ell} \\right)} \\tanh{\\left(\\frac{t}{\\ell} \\right)}}{2} + \\cosh{\\left(\\frac{2 t}{\\ell} \\right)} + 2\\right) \\sin^{2}{\\left(\\chi \\right)} \\sin^{2}{\\left(\\theta \\right)}\\end{matrix}\\right]",
